# vcpkg installed packages
/vcpkg_installed/

# Packaged application binaries; keep distributable resources and documentation
/bin_ext/*
!/bin_ext/README.md
/bin_th_dnh/*
!/bin_th_dnh/resource/
!/bin_th_dnh/license.txt
!/bin_th_dnh/README.md

# Vendored build dependencies; the submodules directory itself is tracked
/library/*
!/library/.Information.txt
